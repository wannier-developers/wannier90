! Copper, as in testw90_read_ibz_disentangle, but reading the full-BZ files
! copper.mmn, copper.amn and copper.eig written by testw90_read_ibz_write
! (write_ibz_expanded) instead of the IBZ files. The result must be the same.

num_bands       = 12
num_wann        =  7
num_iter        = 200

dis_win_max     = 38.0
dis_froz_max    = 13.0
dis_num_iter    =  50
dis_mix_ratio   = 1.0


begin unit_cell_cart
bohr
-3.411 0.000 3.411
 0.000 3.411 3.411
-3.411 3.411 0.000
end unit_cell_cart

begin atoms_frac
Cu 0.00   0.00   0.00
end atoms_frac

begin projections
Cu:d
f=0.25,0.25,0.25:s
f=-0.25,-0.25,-0.25:s
end projections

mp_grid : 4 4 4

