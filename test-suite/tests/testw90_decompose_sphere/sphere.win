! Synthetic physics-pinning test for wannier_decompose.
! Single "WF" = isotropic Gaussian about a non-grid-aligned centre:
! the density is pure l=0, so all l>=1 coefficients must vanish
! (up to a tiny grid-discretisation residue). Identity amn +
! num_iter=0 keep U=1, so the WF is exactly the UNK orbital.
! Inputs generated by tools/generate_decompose_synthetic.py.

num_wann    = 1
num_iter    = 0

begin unit_cell_cart
ang
 8.0  0.0  0.0
  0.0 8.0  0.0
  0.0  0.0 8.0
end unit_cell_cart

! Dummy atom marking the true orbital centre
begin atoms_cart
ang
H  3.2117  2.8331  3.4569
end atoms_cart

begin projections
random
end projections

mp_grid : 1 1 1

begin kpoints
0.0 0.0 0.0
end kpoints

wvfn_formatted = .true.

wannier_decompose = true
decompose_n_max   = 3
decompose_l_max   = 2
decompose_r_min   = 2.5
decompose_r_max   = 4.0
decompose_r_cut   = 3.8
