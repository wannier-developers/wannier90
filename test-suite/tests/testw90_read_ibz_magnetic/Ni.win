! Ferromagnetic fcc Ni with spin-orbit coupling: 10 d-like spinor Wannier
! functions, read from the IBZ files (read_ibz).  The magnetisation (along z)
! removes time reversal from the symmetry group, so half of the 16 operations
! in Ni.isym carry a time-reversal flag.
!
! Generated with Quantum ESPRESSO 7.6: pw.x (lspinorb, noncolin,
! Ni.rel-pbe-spn-rrkjus_psl.1.0.0.UPF, ecutwfc 50 Ry, ecutrho 500 Ry,
! celldm(1) = 6.65 bohr, 12x12x12 scf mesh, nbnd = 30 on the 4x4x4 nscf mesh)
! followed by pw2wannier90.x with irr_bz = .true.

num_bands         = 18
num_wann          = 10
spinors           = .true.

! bands 1-8 are the 3s and 3p semicore states, bands 27-30 lie above 45 eV
exclude_bands     = 1-8, 27-30

! the subspace is the projection of the d orbitals onto the 18 bands: the s
! band crosses the d bands, so a frozen window cannot be used with 10 WFs
dis_num_iter      = 0

num_iter          = 3000
conv_window       = 5
conv_tol          = 1.0e-9

read_ibz = .true.

begin projections
Ni:d
end projections

begin unit_cell_cart
bohr
-3.325  0.000  3.325
 0.000  3.325  3.325
-3.325  3.325  0.000
end unit_cell_cart

begin atoms_frac
Ni 0.00 0.00 0.00
end atoms_frac

mp_grid : 4 4 4

