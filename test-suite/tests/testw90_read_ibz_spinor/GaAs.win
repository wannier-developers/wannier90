! GaAs with spin-orbit coupling: 8 sp3 spinor Wannier functions for the
! valence bands, read from the IBZ files (read_ibz)

num_bands         = 8
num_wann          = 8
exclude_bands     = 1-10, 19-26
spinors           = .true.

num_iter          = 1000
conv_window       = 5
conv_tol          = 1.0e-8
guiding_centres   = .true.

read_ibz = .true.

begin projections
As:sp3
end projections

begin unit_cell_cart
bohr
-5.342256    0           5.342256
0            5.342256    5.342256
-5.342256    5.342256    0
end unit_cell_cart

begin atoms_frac
Ga 0.00   0.00   0.00
As 0.25   0.25   0.25
end atoms_frac

mp_grid : 4 4 4

